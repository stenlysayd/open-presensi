# Application Configuration
APP_NAME="Open Presensi"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="generate_a_very_long_secure_random_string_here"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/open_presensi"

# Timezone (Default Indonesia Central / WITA for NTT or WIB)
DEFAULT_TIMEZONE="Asia/Makassar"

# WhatsApp Gateway (Fonnte / Generic Webhook)
WA_ENABLED=false
WA_PROVIDER="fonnte"
WA_API_TOKEN=""
WA_DEVICE_NUMBER=""

# AI Summarizer (Optional: OpenAI or Gemini)
AI_SUMMARY_ENABLED=false
AI_PROVIDER="openai" # "openai" or "gemini"
AI_API_KEY=""
AI_MODEL_NAME="gpt-4o-mini"
